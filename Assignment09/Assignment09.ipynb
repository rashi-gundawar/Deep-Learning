    {
      "cell_type": "code",
      "source": [
        "vit_accuracy = comparison.loc[\"ViT\", \"Accuracy\"]\n",
        "cnn_accuracy = comparison.loc[\"CNN\", \"Accuracy\"]\n",
        "\n",
        "if np.isclose(vit_accuracy, cnn_accuracy):\n",
